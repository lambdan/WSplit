/* Compiled from the native/ directory: windres windows/wsplit.rc */
#include <windows.h>
#include <commctrl.h>
#include "resource.h"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "windows/wsplit.manifest"
IDI_APP ICON "windows/wsplit.ico"
IDR_CLOCKFONT RCDATA "assets/digital-7-mono.ttf"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,5,2,0
PRODUCTVERSION 1,5,2,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "WSplit speedrun timer (native)"
      VALUE "ProductName", "WSplit"
      VALUE "FileVersion", "1.5.2"
      VALUE "ProductVersion", "1.5.2"
      VALUE "OriginalFilename", "WSplit.exe"
      VALUE "LegalCopyright", "WSplit by Wodanaz, Nitrofski and contributors"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END

IDD_PROMPT DIALOGEX 0, 0, 240, 92
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "WSplit"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
  LTEXT "", IDC_PROMPT_TEXT, 8, 8, 224, 26
  EDITTEXT IDC_PROMPT_EDIT, 8, 36, 224, 14, ES_AUTOHSCROLL
  AUTOCHECKBOX "", IDC_PROMPT_CHECK, 8, 54, 224, 10
  DEFPUSHBUTTON "OK", IDOK, 128, 72, 50, 14
  PUSHBUTTON "Cancel", IDCANCEL, 182, 72, 50, 14
END

IDD_HOTKEY DIALOGEX 0, 0, 240, 92
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Set global hotkey"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
  LTEXT "", IDC_HOTKEY_TEXT, 8, 8, 224, 20
  CONTROL "", IDC_HOTKEY_CTRL, HOTKEY_CLASS, WS_BORDER | WS_TABSTOP, 8, 32, 224, 14
  AUTOCHECKBOX "Also hold the Windows key", IDC_HOTKEY_WIN, 8, 52, 224, 10
  PUSHBUTTON "Clear", IDC_HOTKEY_CLEAR, 8, 72, 50, 14
  DEFPUSHBUTTON "OK", IDOK, 128, 72, 50, 14
  PUSHBUTTON "Cancel", IDCANCEL, 182, 72, 50, 14
END

IDD_RUNEDIT DIALOGEX 0, 0, 420, 300
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Run Editor"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
  LTEXT "Run title:", -1, 8, 10, 40, 10
  EDITTEXT IDC_RE_TITLE, 50, 8, 210, 13, ES_AUTOHSCROLL
  LTEXT "Attempts:", -1, 272, 10, 40, 10
  EDITTEXT IDC_RE_ATTEMPTS, 316, 8, 40, 13, ES_NUMBER
  LTEXT "Goal:", -1, 8, 27, 40, 10
  EDITTEXT IDC_RE_GOAL, 50, 25, 210, 13, ES_AUTOHSCROLL
  LTEXT "Start delay (s):", -1, 272, 27, 50, 10
  EDITTEXT IDC_RE_DELAY, 326, 25, 30, 13, ES_AUTOHSCROLL
  LTEXT "", IDC_RE_HELP, 8, 44, 404, 18
  EDITTEXT IDC_RE_SEGS, 8, 64, 404, 206, ES_MULTILINE | ES_AUTOVSCROLL | ES_AUTOHSCROLL | ES_WANTRETURN | WS_VSCROLL | WS_HSCROLL
  PUSHBUTTON "Auto-fill best segments", IDC_RE_AUTOFILL, 8, 278, 100, 14
  DEFPUSHBUTTON "OK", IDOK, 308, 278, 50, 14
  PUSHBUTTON "Cancel", IDCANCEL, 362, 278, 50, 14
END
